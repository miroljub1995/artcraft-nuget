<Project>
  <Import Project="$(MSBuildThisFileDirectory)eng/PhotoCraft.props" />

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- Everything lands under artifacts/ (bin, obj, package). -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <!-- Pinned to the root: nested Directory.Build.props files would otherwise move it. -->
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Package versions follow the upstream PhotoCraft version. A repackaging-only fix (same upstream
    binaries) gets a fourth part: `dotnet pack -p:PackageRevision=1` gives 0.8.2.1.
  -->
  <PropertyGroup>
    <Version>$(PhotoCraftVersion)</Version>
    <Version Condition="'$(PackageRevision)' != ''">$(PhotoCraftVersion).$(PackageRevision)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Miroljub Tomic</Authors>
    <Copyright>Copyright (c) 2026 Miroljub Tomic</Copyright>
    <PackageProjectUrl>https://github.com/miroljub1995/artcraft-nuget</PackageProjectUrl>
    <RepositoryUrl>https://github.com/miroljub1995/artcraft-nuget</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>photocraft;image;psd;cli;native</PackageTags>
  </PropertyGroup>
</Project>
