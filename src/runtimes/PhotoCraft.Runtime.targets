<Project>
  <!--
    Shipped in every ArtCraft.PhotoCraft.Runtime.<rid> package as buildTransitive/<package id>.targets.
    Every package defines the same targets, so the last one imported runs once for all of them.
  -->

  <!--
    .NET Framework projects don't use the runtimes/ folder of a package, so copy this package's binary
    to the same place .NET does: <output>/runtimes/<rid>/native/.
  -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <None Include="$(MSBuildThisFileDirectory)../runtimes/**/*"
          Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <!-- Single-file publish: keep photocraft-cli next to the app, where ArtCraft.PhotoCraft looks for it. -->
  <Target Name="_PhotoCraftExcludeFromSingleFile" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(Filename)' == 'photocraft-cli'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    NuGet doesn't keep file permissions: it extracts every file as 744, executable by its owner only, so
    an app running as another user (e.g. `app` in the .NET container images) can't start photocraft-cli.
    Make it 755 right after the build or publish copies it, as Microsoft.Playwright does for its node.
    One target per copy: MSBuild runs a target only once per build, and `dotnet publish` copies to the
    build output first. Building on Windows for Linux can't do this; chmod +x it in the Dockerfile instead.
  -->
  <Target Name="_PhotoCraftSetExecuteBitInOutput" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(OS)' != 'Windows_NT'">
    <ItemGroup>
      <_PhotoCraftExecutable Include="$(OutDir)photocraft-cli;$(OutDir)runtimes/*/native/photocraft-cli" />
    </ItemGroup>
    <Exec Condition="'@(_PhotoCraftExecutable->Exists())' != ''"
          Command="chmod +x @(_PhotoCraftExecutable->Exists()->'&quot;%(FullPath)&quot;', ' ')"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="_PhotoCraftSetExecuteBitInPublish" AfterTargets="CopyFilesToPublishDirectory" Condition="'$(OS)' != 'Windows_NT'">
    <ItemGroup>
      <_PhotoCraftPublishedExecutable Include="$(PublishDir)photocraft-cli;$(PublishDir)runtimes/*/native/photocraft-cli" />
    </ItemGroup>
    <Exec Condition="'@(_PhotoCraftPublishedExecutable->Exists())' != ''"
          Command="chmod +x @(_PhotoCraftPublishedExecutable->Exists()->'&quot;%(FullPath)&quot;', ' ')"
          ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
