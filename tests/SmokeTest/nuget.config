<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Its own package cache, so a re-packed version (same number, new contents) is never shadowed by an older copy. -->
    <add key="globalPackagesFolder" value="../../artifacts/smoke/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/package/release" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="ArtCraft.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
